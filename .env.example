# Copier ce fichier vers `.env.local` puis renseigner les valeurs.
# cp .env.example .env.local

# Base de données (SQLite en local, voir docs/23-DEPLOIEMENT.md)
DATABASE_URL="file:./dev.db"

# Base de données persistante (Turso/libSQL, optionnel)
# Pour activer la base distante, remplacer DATABASE_URL par l'URL libsql:// fournie
# par Turso et renseigner TURSO_AUTH_TOKEN (cf. docs/23-DEPLOIEMENT.md).
# DATABASE_URL="libsql://autoafrica-xxxx.turso.io"
# TURSO_AUTH_TOKEN="replace-with-turso-token"

# Secret de signature des jetons JWT (obligatoire, jamais de valeur par défaut)
# Générer un secret fort : openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Google Analytics 4 (gtag.js) — cf. docs/09-TRACKING.md
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXXXXXXXXXX"

# Optional : secret NextAuth (référencé dans docs/23-DEPLOIEMENT.md et docs/20-SECURITY.md)
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# OAuth 2.0 Credentials (Google Cloud Console & Meta for Developers)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

NEXT_PUBLIC_APP_URL="https://autoafrique-saas.vercel.app"

# Signature des webhooks de paiement Mobile Money (obligatoire en production)
# Sans ce secret, l'application REFUSE tous les webhooks en production (fail closed),
# afin qu'un tiers ne puisse pas marquer une commande comme payée.
# Générer : openssl rand -hex 32
# CinetPay — valeurs fournies par le compte marchand (www.cinetpay.com).
#
# Ces trois variables commandent l'encaissement reel :
#   - CINETPAY_API_KEY + CINETPAY_SITE_ID ouvrent la transaction et rappellent
#     l'API qui fait autorite sur son statut ;
#   - CINETPAY_SECRET_KEY verifie le HMAC x-token des notifications.
#
# Tant qu'API_KEY et SITE_ID sont absents, le paiement en ligne est desactive :
# la commande est enregistree et l'acheteur voit « Commande enregistree, le
# vendeur vous contactera ». Rien n'est jamais annonce comme paye.
#
# NEXT_PUBLIC_APP_URL doit etre l'URL publique reelle : c'est elle qui construit
# notify_url. Une valeur fausse ferait encaisser sans que la commande passe a
# PAID. L'URL de notification a declarer sur le tableau de bord CinetPay est
# <NEXT_PUBLIC_APP_URL>/api/v1/payments/webhook.
CINETPAY_SECRET_KEY="valeur-fournie-par-cinetpay"
CINETPAY_API_KEY="valeur-fournie-par-cinetpay"
CINETPAY_SITE_ID="valeur-fournie-par-cinetpay"
